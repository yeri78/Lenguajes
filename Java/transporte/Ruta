package transporte;

// Responsable: Integrante 3 (red, rutas y estadísticas)

/** Camino (lista enlazada de ids de ubicación) con sus totales. */
public record Ruta(ListaEnlazada<String> nodos, double distanciaKm, double tiempoMin, double costo) {
    public String texto() {
        return nodos.unir("->");
    }
}