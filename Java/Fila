package transporte;

// Responsable: Integrante 1 (modelos y validación)

/** Una fila de CSV: columnas con sus valores (sin usar Map). */
public final class Fila {
    private final String[] columnas;
    private final String[] celdas;

    public Fila(String[] columnas, String[] celdas) {
        this.columnas = columnas;
        this.celdas = celdas;
    }

    /** Crea una fila desde pares clave, valor, clave, valor... (útil en pruebas). */
    public static Fila de(String... pares) {
        String[] columnas = new String[pares.length / 2];
        String[] celdas = new String[pares.length / 2];
        for (int i = 0; i < columnas.length; i++) {
            columnas[i] = pares[2 * i];
            celdas[i] = pares[2 * i + 1];
        }
        return new Fila(columnas, celdas);
    }

    /** Devuelve el valor de la columna, o null si la columna no existe. */
    public String obtener(String campo) {
        for (int i = 0; i < columnas.length; i++) {
            if (columnas[i].trim().equals(campo)) {
                return i < celdas.length ? celdas[i].trim() : "";
            }
        }
        return null;
    }

    public String obtenerOpcional(String campo, String defecto) {
        String valor = obtener(campo);
        return (valor == null || valor.isEmpty()) ? defecto : valor;
    }
}