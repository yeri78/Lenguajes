# Responsable: Integrante 3 (red, rutas y estadísticas)
"""Resumen estadístico del procesamiento."""
from .lista_enlazada import ListaEnlazada


def _f2(numero):
    return f"{numero:.2f}"


def resumir(resultados, flota):
    """Devuelve una lista enlazada de pares (metrica, valor)."""
    asignadas = resultados.filtrar(lambda r: r.estado == "ASIGNADA")
    con_ruta = resultados.filtrar(lambda r: r.ruta is not None)
    cumplen = asignadas.contar(lambda r: r.cumple_sla == "SI")
    promedio = 0 if con_ruta.esta_vacia() else con_ruta.sumar(lambda r: r.ruta.tiempo_min) / con_ruta.tamano()
    porcentaje = 0 if asignadas.esta_vacia() else 100.0 * cumplen / asignadas.tamano()

    resumen = ListaEnlazada()

    def agregar(metrica, valor):
        resumen.agregar_final((metrica, str(valor)))

    agregar("total_solicitudes", resultados.tamano())
    agregar("asignadas", asignadas.tamano())
    agregar("en_cola", resultados.contar(lambda r: r.estado == "EN_COLA"))
    agregar("sin_ruta", resultados.contar(lambda r: r.estado == "SIN_RUTA"))
    agregar("vehiculos_disponibles", flota.disponibles().tamano())
    agregar("vehiculos_ocupados", flota.ocupados().tamano())
    agregar("distancia_total_km", _f2(asignadas.sumar(lambda r: r.ruta.distancia_km)))
    agregar("costo_total", _f2(asignadas.sumar(lambda r: r.ruta.costo)))
    agregar("tiempo_promedio_min", _f2(promedio))
    agregar("cumplen_sla", cumplen)
    agregar("porcentaje_sla", _f2(porcentaje))
    return resumen